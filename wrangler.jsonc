{
  // Worker "onresort" (Cloudflare Workers Builds): landing page + CRM em /admin
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onresort",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // a página principal passa pelo Worker (cookies próprios + PageView pelo servidor)
    "run_worker_first": ["/", "/index.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onresort-crm",
      "database_id": "65fe54a8-ab73-40ff-bc1f-355da5984443"
    }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "vars": {
    // ID do pixel da Meta (público). O token da API de Conversões vai como
    // Secret META_CAPI_TOKEN no painel do Cloudflare, nunca neste arquivo.
    "META_PIXEL_ID": "650460263189144",
    // domínio oficial: o endereço *.workers.dev redireciona para cá
    "SITE_URL": "https://onresort.lancamentobarra.com.br"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
